{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AndroidSignTool",
  "version": "0.1.0",
  "identifier": "com.androidsigntool.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Android APK 签名工具",
        "width": 980,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ws1993/AndroidSignTool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NjYwOTcxREUxMzk3RDAKUldUUWx4UGVjUWxtbWU5VzMvZ2dGK1ZTZEtkejRLL003SlNXNFV2QVQzSHdzVDBqVnZXYTliR0cK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"]
  }
}
